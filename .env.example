# ============================================================
# LEJOMER — Configuración de ejemplo
# ============================================================

# Aplicación
APP_NAME=LEJOMER Image Reconstruction
APP_ENV=development
DEBUG=true

# Base de datos
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/lejomer_db

# Seguridad
SECRET_KEY=CAMBIAR_ESTA_CLAVE_EN_ENTORNO_REAL

# Archivos
MAX_UPLOAD_SIZE_MB=20

# Procesamiento
DEFAULT_SCALE_FACTOR=1
