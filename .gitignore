# ============================================================
# LEJOMER — Reconstrucción de Imágenes
# Git Ignore
# ============================================================

# Entornos virtuales de Python
venv/
.venv/
env/

# Caché de Python
__pycache__/
*.py[cod]

# Archivos de configuración local
.env

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales
*.tmp
*.temp
*.log

# Jupyter Notebook
.ipynb_checkpoints/

# Entornos y configuraciones de IDE
.vscode/
.idea/

# Node.js
node_modules/

# Archivos generados
dist/
build/

# Archivos de cobertura de pruebas
.coverage
htmlcov/

# Archivos de modelos de IA descargados localmente
*.pt
*.pth
*.onnx

# Datos de procesamiento local
data/input/*
data/output/*

# Mantener las carpetas de datos en Git
!data/input/.gitkeep
!data/output/.gitkeep
